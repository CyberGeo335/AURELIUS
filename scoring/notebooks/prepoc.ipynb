   "source": [
    "from pathlib import Path\n",
    "\n",
    "DATA_DIR = Path(\"ml_data_final\")\n",
    "\n",
    "for path in sorted(DATA_DIR.rglob(\"*\")):\n",
    "    if path.is_file():\n",
    "        print(f\"{path.relative_to(DATA_DIR)} | {path.stat().st_size / 1024**2:.2f} MB\")"
   ]
