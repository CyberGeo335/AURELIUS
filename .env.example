# Скопируйте в .env. Обязательно задайте непустой пароль. Файл .env не коммитить.
# Значения с $ или # заключайте в одинарные кавычки (правила Docker Compose).
POSTGRES_PASSWORD=
POSTGRES_USER=aurelius
POSTGRES_DB=business_scoring
# PostgreSQL доступен с хоста только через loopback; внутри Docker всегда db:5432.
POSTGRES_PORT=5433
# Для доступа с других компьютеров: APP_BIND_HOST=0.0.0.0. HTTPS здесь не настроен.
APP_BIND_HOST=127.0.0.1
APP_PORT=5173
# Уникальное имя проекта изолирует контейнеры и тома.
COMPOSE_PROJECT_NAME=aurelius
# Сначала start.sh/start.ps1 проверяет этот адрес из контейнера.
# Если недоступен, запускает Ollama в Docker; на хост ничего не устанавливается.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:20b
# Только http: применяется при сборке фронта, после изменения нужна пересборка.
VITE_API_MODE=http
# DATABASE_URL собирается внутри контейнера из PG_* с URL-кодированием пароля.
# Штатные артефакты: /app/scoring/main/ml_scoring/model/{best_model.cbm,features.json,best_config.json}.
